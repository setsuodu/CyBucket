/* 位置由 HomeUI C# 像素赋值，这里只做外观，禁止 translate/top:50% */
.login-popup {
    position: absolute;
}

.login-dim {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.65);
}

.login-window {
    padding: 28px 32px 24px 32px;
    background-color: rgb(45, 50, 65);
    border-radius: 16px;
    flex-direction: column;
}

.login-title {
    margin-bottom: 20px;
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    height: 36px;
}

.login-input {
    margin-bottom: 12px;
    height: 40px;
    font-size: 16px;
}

.login-buttons {
    margin-top: 16px;
    height: 48px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.secondary-button {
    width: 48%;
    height: 44px;
    font-size: 18px;
    background-color: rgb(90, 90, 100);
    color: rgb(255, 255, 255);
}

.primary-button {
    width: 48%;
    height: 44px;
    font-size: 18px;
    background-color: rgb(50, 110, 200);
    color: rgb(255, 255, 255);
}
