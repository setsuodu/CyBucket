.login-popup {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    /* 补上这一句 */
    display: flex;
    align-items: center;
    justify-content: center;
}

.login-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
}

.login-window {
    width: 420px;
    min-height: 280px;
    padding: 32px;
    background-color: rgb(45, 50, 65);
    border-radius: 16px;
    
    /* 改用逻辑居中 */
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.login-title {
    margin-bottom: 24px;
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.login-input {
    margin-bottom: 16px;
    font-size: 16px;
    min-height: 36px;
}

.login-buttons {
    margin-top: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.login-buttons Button {
    width: 160px;
    height: 44px;
    font-size: 18px;
}

.secondary-button {
    background-color: rgb(90, 90, 100);
}

.primary-button {
    background-color: rgb(50, 110, 200);
}
