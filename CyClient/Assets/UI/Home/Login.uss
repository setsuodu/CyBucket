.login-popup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.login-dim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
}

.login-window {
    position: absolute;
    width: 420px;
    padding: 32px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgb(45, 50, 65);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.login-title {
    margin-bottom: 24px;
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
}

.login-input {
    margin-bottom: 16px;
    font-size: 16px;
}

.login-buttons {
    margin-top: 16px;
    flex-direction: row;
    justify-content: space-between;
}

.login-buttons Button {
    width: 160px;
    height: 44px;
    font-size: 18px;
}

.secondary-button {
    background-color: rgb(90, 90, 100);
}

.primary-button {
    background-color: rgb(50, 110, 200);
}
